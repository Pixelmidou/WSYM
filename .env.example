# ============================================================================
#  WSYM configuration - copy this file to ".env" in the same folder.
#  Windows hides dot-files: File Explorer > View > tick "Hidden items".
# ============================================================================

# ---- Database (stock XAMPP: user "root", empty password) -------------------
database_hostname=localhost
database_username=root
database_password=
database_name=wsym

# ---- Mail -----------------------------------------------------------------
# Pick ONE of these, then set the values in the matching block below.
#
# file  : write the mails to a temp folder, read them at tools/mailbox.php
#         offline demo, nothing leaves the machine          (default, needs nothing)
# smtp  : hand the mails to an SMTP server - either your own on 127.0.0.1
#         (Mailpit/MailHog/smtp4dev/Postfix) or a remote host
# gmail : send through your own Gmail account with an App Password
# mail  : PHP mail(); needs sendmail.exe configured on XAMPP
mailer_transport=file

# Used by smtp AND gmail. Empty username = no login at all (normal for a
# local catcher). Password is the 16 characters of a Gmail App Password.
mailer_username=
mailer_password=

# --- smtp only --------------------------------------------------------------
# A local relay: host 127.0.0.1 (or localhost) and port 1025 = Mailpit/MailHog,
# 2525 = smtp4dev, 25 = Postfix. A plain local relay needs mailer_secure empty.
mailer_host=
mailer_port=465
mailer_secure=ssl

# --- Gmail only -------------------------------------------------------------
# gmail ignores mailer_host and always talks to smtp.gmail.com.
# 465 + ssl, or 587 + tls. Leave mailer_username/password as your Gmail details.

# --- Both -------------------------------------------------------------------
mailer_from_name="WSYM Banking"
email_verif_address=no-reply@wsym.local
mailer_timeout=15

# ---- URLs ------------------------------------------------------------------
# Leave empty: the app works out its own address, so http://localhost/stuff/wsym/
# works without touching anything. Set it only if links inside emails must point
# somewhere else, e.g. base_url=http://localhost/stuff/wsym
base_url=
