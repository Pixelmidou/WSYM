# ============================================================================
#  WSYM configuration - copy this file to ".env" in the same folder.
#  Windows hides dot-files: File Explorer > View > tick "Hidden items".
# ============================================================================

# ---- Database (stock XAMPP: user "root", empty password) -------------------
database_hostname=localhost
database_username=root
database_password=
database_name=wsym

# ---- Mail -----------------------------------------------------------------
# file  : save mails to a temp folder, read them at tools/mailbox.php  (offline demo)
# gmail : send through your own Gmail account (App Password, not your normal password)
# smtp  : any other server (Mailtrap, Outlook, your host)
# mail  : PHP mail(); needs sendmail.exe on XAMPP
mailer_transport=file

# --- Gmail ------------------------------------------------------------------
mailer_username=your.address@gmail.com
mailer_password=
mailer_port=465
mailer_secure=ssl

# --- Generic SMTP (only when mailer_transport=smtp) -------------------------
mailer_host=smtp.gmail.com
mailer_from_name="WSYM Banking"
email_verif_address=no-reply@wsym.local
mailer_timeout=15

# ---- URLs ------------------------------------------------------------------
# Leave empty: the app works out its own address, so http://localhost/stuff/wsym/
# works without touching anything. Set it only if links inside emails must point
# somewhere else, e.g. base_url=http://localhost/stuff/wsym
base_url=
